-- 🛸 ระบบการบินออโต้แบบไม่ต้องกดอะไร (AUTOMATIC LOOP)
---------------------------------------------------------

-- ฟังก์ชันคุมการบินเคลื่อนที่แบบนุ่มนวล
local function smoothFlyTo(targetPos, speed, customHeight)
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
	local hrp = char.HumanoidRootPart

	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local heightOffset = customHeight or flyHeight
	local destination = targetPos + Vector3.new(0, heightOffset, 0)
	local distance = (destination - hrp.Position).Magnitude
	local currentSpeed = math.clamp(speed or 100, 1, 1000)
	local timeToFly = distance / currentSpeed

	local tweenInfo = TweenInfo.new(
		timeToFly,
		Enum.EasingStyle.Linear,
		Enum.EasingDirection.Out
	)

	currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(destination)})
	currentTween:Play()

	local completed = false
	local conn
	conn = currentTween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed then
			completed = true
		end
		conn:Disconnect()
	end)

	while not completed and autoFarmActive do
		task.wait(0.05)
	end

	return completed
end

-- ฟังก์ชันค้นหาไข่ที่ไกลที่สุด
local function getFarthestEggPos()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local hrp = char.HumanoidRootPart

	local farthestEgg = nil
	local maxDist = 0

	for _, obj in pairs(workspace:GetDescendants()) do
		if obj.Name:lower():find("egg") and (obj:IsA("BasePart") or obj:IsA("Model")) then
			local pos = obj:IsA("BasePart") and obj.Position or obj:GetPivot().Position
			local dist = (pos - hrp.Position).Magnitude
			if dist > maxDist then
				maxDist = dist
				farthestEgg = pos
			end
		end
	end

	return farthestEgg
end

-- ลูปการบินออโต้ไป-กลับเอง
local function startAutoFarmLoop()
	task.spawn(function()
		while autoFarmActive do
			if not savedBaseCFrame then
				sendNotification("แจ้งเตือน", "กรุณากด 'ปักหมุดตำแหน่งฐาน' ก่อน!")
				autoFarmActive = false
				break
			end

			local eggPos = getFarthestEggPos()
			if eggPos then
				-- 🟢 Step 1: บินไปหาไข่ที่ไกลที่สุดเองอัตโนมัติ
				sendNotification("ออโต้ฟาร์ม", "กำลังบินไปเก็บไข่ (ความเร็ว: " .. flySpeedToEgg .. ")...")
				local reachedEgg = smoothFlyTo(eggPos, flySpeedToEgg, flyHeight)

				if reachedEgg and autoFarmActive then
					-- โฉบลงไปแตะเก็บไข่
					smoothFlyTo(eggPos, flySpeedToEgg, 2)
					task.wait(0.2)

					-- 🟢 Step 2: บินพาไข่กลับฐานเองอัตโนมัติ
					sendNotification("ออโต้ฟาร์ม", "เก็บไข่แล้ว! กำลังบินกลับฐาน (ความเร็ว: " .. flySpeedToBase .. ")...")
					smoothFlyTo(savedBaseCFrame.Position, flySpeedToBase, flyHeight)

					-- วางไข่ลงฐาน
					local char = player.Character
					if char and char:FindFirstChild("HumanoidRootPart") then
						char.HumanoidRootPart.CFrame = savedBaseCFrame
					end

					task.wait(0.4)
				end
			else
				sendNotification("ออโต้ฟาร์ม", "ไม่พบไข่ในแมพ กำลังรอไข่เกิด...")
				task.wait(2)
			end
			task.wait(0.1)
		end
	end)
end

